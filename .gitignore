# ==========================================
# ARQUIVOS DO PROJETO IGNORADOS
# ==========================================
backend/src/main/resources/*
# Conta de e-mail padrao embutida no JAR (contem a senha de app; modelo: backend/email-padrao.exemplo.properties)
backend/src/main/resources/email-padrao.properties
!backend/src/main/resources/db/
!backend/src/main/resources/application.properties
*.zip
*.7z
*.sql
# package-lock.json gerado por npm rodado fora do frontend (o do frontend é versionado)
/package-lock.json
backend/package-lock.json

# Banco de dados e configuração local (credenciais) do ambiente de desenvolvimento
backend/dados/
# Banco gerado pela antiga ferramenta de migração SQL Server -> Firebird (removida)
/migracao/
*.fdb
*.FDB

# Scripts de estrutura do banco (Flyway) são versionados
!backend/src/main/resources/db/migration/*.sql
Annotations
novasImplementacoes.md
Melhorias.md
.claude

# Licenca: chave privada do fornecedor e licenca ativada (nunca versionar)
*.key
licenca.lic
